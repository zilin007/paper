# Obsidian
.obsidian/

# 虚拟环境
.venv/

# PDF 图片提取临时文件（全页截图，裁剪完成后无需保留）
**/resource/page*_full_*dpi.png

# 论文元信息（由 CLI 自动生成，不必追踪）
**/meta.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 各平台生成的配置目录（从 .mcp.json 复制而来，无需追踪）
.cursor/
.vscode/mcp.json

# arXiv MCP server 缓存（由 arxiv-mcp-server 自动管理）
.arxiv-cache/

# ============ Blog (VitePress) ============
# 依赖
blog/node_modules/
# 构建产物
blog/.vitepress/dist/
blog/.vitepress/cache/
# 同步脚本生成的文件（由 scripts/sync-papers.mjs 在构建时生成）
blog/posts/

# OS
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
*.swp
*.swo
*~
